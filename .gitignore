# ---------------------------------------------------------------
# PRIVACY: company data must never be committed to this repository.
# .gitignore does NOT protect files that are already tracked; always
# review `git status` and `git diff --cached` before committing.
# ---------------------------------------------------------------

# Data: only the synthetic demonstration sample is publishable.
data/*
!data/sample/
data/sample/*
!data/sample/demo_operations.csv
!data/sample/README.md

# Private package, raw workbooks and archives (anywhere in the tree)
# NOTE: these patterns also match tracked-looking names, so new modules and
# tests must not contain "private" in their path (use "operational").
*PRIVATE*
*private*
AgriFlight_Dataset_v0_1/
AgriFlight_Integrated_*/
Dataset/
*_RESTRICTED*/
*RESTRICTED*
identity_key.json
*.zip
*.7z
*.rar
*.xlsx
*.xlsm
*.xls
*.parquet
*.feather
*.sqlite
*.db

# Generated reports, exports and model artifacts
reports/
outputs/
exports/
models/
mlruns/
*.pkl
*.pickle
*.joblib
*.onnx
*.h5

# Secrets and local configuration
.env
.env.*
*.pem
*.key
.streamlit/secrets.toml
# Personal Claude Code settings (never committed)
.claude/settings.local.json

# Python environments, caches and build output
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
